# ---------------------------------------------------------------------------------------------
# ZION server configuration. Copy to apps/server/.env (or export in your shell) and adjust.
# Secrets come ONLY from the environment — never commit real values.
# ---------------------------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
LOG_PRETTY=true

DATABASE_URL=postgres://zion:zion_dev_password@localhost:5433/zion
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DB_MIGRATE_ON_START=true
# Optional for one instance; required when running several (tickets + rate limits are shared).
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev_only_jwt_key_replace_in_production_0123456789
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
ALLOW_GUEST=true

CORS_ORIGINS=http://localhost:3000
PUBLIC_WS_URL=ws://localhost:4000/ws
TRUST_PROXY=false
# Camp Studio (/studio): anyone who enters this password can edit the camp. Change it!
STUDIO_PASSWORD=change-me
# METRICS_TOKEN=at-least-16-random-characters

WORLD_ID=main
# Only used when the world is first created; afterwards the persisted seed wins.
WORLD_SEED=zion-alpha
WORLD_SIZE_CHUNKS=128
DAY_LENGTH_MINUTES=24
# Ground-cover regrowth: 3 = default, higher = faster, 0 = disabled.
RANDOM_TICK_SPEED=3
WORLDGEN_WORKERS=2
CHUNK_CACHE_SIZE=12000

MAX_CONNECTIONS=500
MAX_CONNECTIONS_PER_IP=6
WS_UPGRADES_PER_IP_PER_MIN=20

# ---------------------------------------------------------------------------------------------
# Web client (apps/web/.env.local)
# ---------------------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
