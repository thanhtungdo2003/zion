# ---------------------------------------------------------------------------------------------
# ZION server configuration. Copy to apps/server/.env (or export in your shell) and adjust.
# Secrets come ONLY from the environment — never commit real values.
# ---------------------------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
LOG_PRETTY=true

DATABASE_URL=postgres://zion:zion_dev_password@localhost:5433/zion
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DB_MIGRATE_ON_START=true
# Optional for one instance; required when running several (tickets + rate limits are shared).
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev_only_jwt_key_replace_in_production_0123456789
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
ALLOW_GUEST=true

CORS_ORIGINS=http://localhost:3000
PUBLIC_WS_URL=ws://localhost:4000/ws
TRUST_PROXY=false
# Camp Studio (/studio): anyone who enters this password can edit the camp. Change it!
STUDIO_PASSWORD=change-me
# Model Studio AI agent (OpenAI-compatible endpoint, as model-generator uses). Without a key the agent
# runs its built-in planner (houses, rocks, kit assemblies). The key never reaches browsers.
# AI_API_KEY=
# AI_BASE_URL=https://ai.mangso.net/v1
# AI_MODEL=cx/gpt-5.6-sol
# AI_TIMEOUT_MS=180000
# AI_MAX_RETRIES=3
# Desktop app content updates: the folder written by `pnpm --filter @zion/desktop build` (release/update).
# DESKTOP_UPDATE_DIR=/srv/zion/desktop-update
# METRICS_TOKEN=at-least-16-random-characters

WORLD_ID=main
# Only used when the world is first created; afterwards the persisted seed wins.
WORLD_SEED=zion-alpha
WORLD_SIZE_CHUNKS=128
DAY_LENGTH_MINUTES=24
# Ground-cover regrowth: 3 = default, higher = faster, 0 = disabled.
RANDOM_TICK_SPEED=3
WORLDGEN_WORKERS=2
CHUNK_CACHE_SIZE=12000

MAX_CONNECTIONS=500
MAX_CONNECTIONS_PER_IP=6
WS_UPGRADES_PER_IP_PER_MIN=20

# ---------------------------------------------------------------------------------------------
# Web client (apps/web/.env.local)
# ---------------------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# Social login: configure these on the server only; never use NEXT_PUBLIC_ for secrets.
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=your-google-web-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=your-facebook-app-secret
