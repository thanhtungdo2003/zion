{
  "name": "zion",
  "version": "0.1.0",
  "private": true,
  "description": "ZION — The Last Light: authoritative multiplayer 3D zombie survival (monorepo)",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @zion/server --filter @zion/web dev",
    "dev:server": "pnpm --filter @zion/server dev",
    "dev:web": "pnpm --filter @zion/web dev",
    "build": "pnpm -r build",
    "start:server": "pnpm --filter @zion/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "pnpm --filter @zion/server migrate",
    "world:preview": "pnpm --filter @zion/worldgen preview",
    "assets:build": "pnpm --filter @zion/assets build:manifest",
    "desktop:local": "pnpm --filter @zion/desktop build:local",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "camp:verify": "pnpm --filter @zion/server verify:camp"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  }
}
