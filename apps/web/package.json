{
  "name": "@zion/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @zion/assets build:manifest",
    "dev": "next dev -p 3000",
    "prebuild": "pnpm --filter @zion/assets build:manifest",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node aapanel-start.mjs",
    "check:standalone": "node scripts/check-standalone.mjs",
    "test:standalone": "node --test scripts/standalone.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.142",
    "@iconify/react": "^6.0.2",
    "@zion/assets": "workspace:*",
    "@zion/physics": "workspace:*",
    "@zion/shared": "workspace:*",
    "@zion/worldgen": "workspace:^",
    "jolt-physics": "^1.1.0",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0"
  }
}
